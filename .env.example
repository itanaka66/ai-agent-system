# ============================================
# AI Agent System Environment Variables
# ============================================

# Security
SECRET_KEY="change-this-to-random-secret-key"
DEBUG=false
API_TOKEN="your-api-token-here"

# GPU Nodes - Ollama URLs
OLLAMA_MASTER_URL=http://192.168.0.180:11434
OLLAMA_WORKER_URL=http://192.168.0.251:11434

# GPU Models
MODEL_GPT_THINKER="qwen2.5:32b"
MODEL_FAST_EXECUTOR="llama3:8b"

# CPU Cluster (Comma-separated Ollama URLs; used round-robin as target "cpu_cluster"
# in Agent Console / Workflow Builder). Example with 3 CPU nodes:
# OLLAMA_CPU_NODES="http://192.168.0.161:11434,http://192.168.0.162:11434,http://192.168.0.163:11434"
OLLAMA_CPU_NODES=""

# PostgreSQL
POSTGRES_HOST=192.168.0.151
POSTGRES_PORT=5432
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=ai_agent_db

# Qdrant Vector Store
QDRANT_HOST=http://192.168.0.252:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_CORPUS="corpus_docs"
QDRANT_COLLECTION_HISTORY="chat_history_vectors"

# Monitoring
PROMETHEUS_URL=http://192.168.0.197:9090
GRAFANA_URL=http://192.168.0.199:3000

# Workflow Tool (Flowise)
FLOWISE_URL=http://192.168.0.XXX:3001
FLOWISE_FLOW_ID=""
FLOWISE_API_KEY=""

# Service Settings
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL="INFO"

# CORS (comma-separated allowed origins for the web UI). "*" or unset allows all
# origins (development default) - set explicit origins in production, e.g.:
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ORIGINS="*"