# ============================================
# AI Agent System - Docker Quick Start Environment
# ============================================
# For running EVERYTHING via docker-compose (`./install.sh --all` or
# `./install.ps1 --all`), including this app's own backend/frontend.
# Points at the docker-compose service names (ollama/postgres/qdrant)
# instead of dedicated hardware IPs, and defaults to small models that
# run on a laptop/cloud VM without a GPU. See README "Quick Start".
#
# For the production/dedicated-hardware setup (RTX 3090 + Intel Arc A770 +
# CPU cluster), use .env.example instead.

# Security - change these before exposing this beyond your own machine
SECRET_KEY="change-this-to-random-secret-key"
DEBUG=false
API_TOKEN="change-this-api-token"

# Ollama (the "ollama" docker-compose service)
OLLAMA_MASTER_URL=http://ollama:11434
OLLAMA_WORKER_URL=http://ollama:11434

# Small, CPU-friendly default models. After `./install.sh --all`, pull them with:
#   docker compose exec ollama ollama pull llama3:8b
#   docker compose exec ollama ollama pull phi3:mini
MODEL_GPT_THINKER="llama3:8b"
MODEL_FAST_EXECUTOR="phi3:mini"

# CPU Cluster - not used in the single-machine Docker quick start
OLLAMA_CPU_NODES=""

# PostgreSQL (the "postgres" docker-compose service)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=dev_password
POSTGRES_DB=ai_agent_db

# Qdrant Vector Store (the "qdrant" docker-compose service)
QDRANT_HOST=http://qdrant:6333
QDRANT_API_KEY=""
QDRANT_COLLECTION_CORPUS="corpus_docs"
QDRANT_COLLECTION_HISTORY="chat_history_vectors"

# Monitoring - optional, not started by install.sh/install.ps1
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3000

# Workflow Tool (Flowise, the "flowise" docker-compose service) - optional
FLOWISE_URL=http://flowise:8080
FLOWISE_FLOW_ID=""
FLOWISE_API_KEY=""

# Service Settings (the "orchestrator" container listens on this port)
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL="INFO"

# CORS: the "webui" container's nginx proxies same-origin, so the default
# (allow all) is fine for local use.
CORS_ORIGINS="*"
