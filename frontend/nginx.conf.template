# Templated by the nginx image's docker-entrypoint.d/20-envsubst-on-templates.sh
# into /etc/nginx/conf.d/default.conf at container startup (this file lives at
# /etc/nginx/templates/default.conf.template - see frontend/Dockerfile).
# ORCHESTRATOR_HOST/ORCHESTRATOR_PORT default in docker-compose.yml so this
# works out of the box, and can be overridden via .env to point the web UI at
# a backend running elsewhere - no image rebuild needed.

# Resolve the backend hostname at REQUEST time (via Docker's embedded DNS,
# 127.0.0.11) rather than once at nginx startup. Without this, nginx refuses
# to start at all ("host not found in upstream") whenever the backend isn't
# running yet or isn't reachable - e.g. when running --webui on its own.
resolver 127.0.0.11 valid=10s;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # React Router client-side routes (e.g. /workflows/some-name) must fall
    # back to index.html instead of a plain 404 on refresh/direct link.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to the orchestrator. Using a variable (rather than a
    # bare proxy_pass target) forces the deferred, per-request resolution
    # described above.
    location /api/ {
        set $backend "http://${ORCHESTRATOR_HOST}:${ORCHESTRATOR_PORT}";
        proxy_pass $backend/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /metrics {
        set $backend "http://${ORCHESTRATOR_HOST}:${ORCHESTRATOR_PORT}";
        proxy_pass $backend/metrics;
    }
}
